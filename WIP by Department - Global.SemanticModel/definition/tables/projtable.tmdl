	partition projtable = m
		mode: import
		source =
				let
				    Source = Sql.Database("SQL-PROD-EDP-WEU.database.windows.net", "DB-PROD-SYN-SILVER-WEU", [Query="#(lf)    SELECT#(lf)        p.customername AS [Customer Name],#(lf)        p.startdate AS [Start Date],#(lf)        p.enddate AS [End Date],#(lf)        p.name AS [Name],#(lf)        p.projgroupid AS [Project Group ID],#(lf)        p.projectparentname AS [Project Parent Name],#(lf)        p.projectid AS [Project ID],#(lf)        p.projectmanager AS [Project Manager],#(lf)        p.projectparentid AS [Project Header],#(lf)        p.status AS [Project Stage],#(lf)        p.type AS [Project Type],#(lf)        p.HSLCESalesLeadNum,#(lf)        UPPER(p.legalentityid) AS [Contracting Entity (CE)],#(lf)        p.recid,#(lf)        p.locationdim,#(lf)        p.departmentdim,#(lf)        p.businessunitdim,#(lf)        p.teamdim,#(lf)        p.revenuetypedim,#(lf)        p.WorkerResponsible,#(lf)        p.legalentity,#(lf)        p.projectcontroller,#(lf)        dr.refrecid,#(lf)        dr.notes as [Comment],#(lf)        dr.createdon as [Created On],#(lf)        dr.createdby as [Created By],#(lf)        rn#(lf)    FROM cdm.fo_dim_projectv p#(lf)   left join [cdm].[fo_dim_documentreferencev] dr#(lf)   ON dr.refrecid = p.recid AND rn = 1#(lf)    WHERE dr.typeid = 'Note' ", MultiSubnetFailover=true, CreateNavigationProperties=false]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"HSLCESalesLeadNum", "SL"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

