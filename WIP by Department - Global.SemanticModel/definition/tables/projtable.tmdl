	column UniqueFinancialDimension =
			
			LEFT('projtable'[locationdim], 2) &
			'projtable'[departmentdim] &
			'projtable'[businessunitdim] &
			'projtable'[teamdim]
		lineageTag: 3a8745e6-dbba-44ea-8893-75afe14871f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Proj_Stage =
			
			VAR Stage = 'projtable'[Project Stage]
			RETURN
			SWITCH (
			    TRUE(),
			    Stage = 0, "Created",
			    ISBLANK(Stage), "Invoiced",
			    Stage = 3, "In Progress",
			    Stage = 4, "Closed",
			    Stage = 5, "Final Invoice",
			    BLANK()
			)
		lineageTag: bc860d56-d595-465d-bdaf-86a8707a1a5c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Project_Type = ```
			
			SWITCH (
			    TRUE (),
			    'projtable'[Project Group ID] = "1T&M-C",      "Time and materials",
			    'projtable'[Project Group ID] = "1T&M-C(F)",   "Time & Expenses non-billable",
			    'projtable'[Project Group ID] = "1T&M-C(FE)",  "Time non-billable",
			    'projtable'[Project Group ID] = "1T&M-C(+)",   "Client: Time and materials (Dimensions from the employee)",
			    'projtable'[Project Group ID] = "1T&M-IC",     "Intercompany: Time and Material",
			    'projtable'[Project Group ID] = "2FPCP1-C",    "Fixed, % complete, Sales value",
			    'projtable'[Project Group ID] = "3INTRL-C",    "Client: Internal",
			    'projtable'[Project Group ID] = "4ADMIN",      "House: Specific dimensions",
			    'projtable'[Project Group ID] = "4OVERHD",     "House: Overhead (undefined dimensions)",
			    'projtable'[Project Group ID] = "4SALES",      "Sales / Marketing / Account management",
			    'projtable'[Project Group ID] = "5INVST",      "Investment Capitalization Projects",
			    "New"
			)
			
			```
		lineageTag: 079bb71f-62a8-4341-9878-2a4811eaf42e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Project Manager Clean' =
			
			IF (
			    ISBLANK ( [Project Manager] ),
			    "zz_TBC",
			    [Project Manager]
			)
		lineageTag: bdc06a7b-0c08-4810-8242-68ef5dd1871b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column SL_Clean = ```
			
			IF (
			    ISBLANK ( [SL] ),
			    "Z_TBC",
			    [SL]
			)
			
			```
		lineageTag: 5c9f9a59-609d-4ce8-aeaf-b118dab2c21f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

